{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (CPU)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STRATAFLOW_WERROR": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (CPU)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-cuda",
      "inherits": "release",
      "displayName": "Release + CUDA",
      "cacheVariables": { "STRATAFLOW_CUDA": "ON" }
    },
    {
      "name": "release-vulkan",
      "inherits": "release",
      "displayName": "Release + Vulkan",
      "cacheVariables": { "STRATAFLOW_VULKAN": "ON" }
    },
    {
      "name": "release-metal",
      "inherits": "release",
      "displayName": "Release + Metal",
      "cacheVariables": { "STRATAFLOW_METAL": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ]
}
